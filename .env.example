# Database
DATABASE_URL="postgresql://appuser:apppass@localhost:5433/app_dev"

# Local docker host ports (lets npm dev and docker run side-by-side)
# APP_HOST_PORT=3010
# DB_HOST_PORT=5433

# Auth (Identity Server) — configure when integrating your auth provider
# IDENTITY_SERVER_URL=https://identity.yourapp.com
# IDENTITY_SERVER_CLIENT_ID=your-app-web
# IDENTITY_SERVER_CLIENT_SECRET=

# AI (Anthropic) — server-side only, never NEXT_PUBLIC_
# ANTHROPIC_API_KEY=sk-ant-...

# Storage (AWS S3 or equivalent)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Encryption — 32-byte hex string for column-level encryption
# ENCRYPTION_KEY=

# Feature kill switches (set to "true" to instantly disable a route)
# KILL_SWITCH_FEATURE_A=false
# KILL_SWITCH_FEATURE_B=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Face recognition rollout controls
# Embedding-only recognition
# FACE_RECOGNITION_PROVIDER=embedding
# FACE_RECOGNIZER_URL=http://face-recognizer:8000
# FACE_RECOGNIZER_TIMEOUT_MS=7000
# FACE_RECOGNITION_CANDIDATE_LIMIT=120
# FACE_RECOGNIZER_MIN_CONFIDENCE=0.88
# FACE_RECOGNIZER_AMBIGUITY_MARGIN=0.03

# Local auth bypass (dev only)
# DEV_BYPASS_AUTH=true
# DEV_BYPASS_EXTERNAL_ID=ext_platform_admin_001
# DEV_BYPASS_USER_ID=<seeded user id from db, optional>
# DEV_BYPASS_TENANT_ID=<seeded tenant id from db, optional>
# DEV_BYPASS_ROLE=PLATFORM_ADMIN
# DEV_BYPASS_EMAIL=platform@example.com

# Logging
# LOG_LEVEL=debug
