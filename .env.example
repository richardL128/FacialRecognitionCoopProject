# Database
DATABASE_URL="postgresql://user:password@localhost:5432/app_dev"

# Auth (Identity Server) — configure when integrating your auth provider
# IDENTITY_SERVER_URL=https://identity.yourapp.com
# IDENTITY_SERVER_CLIENT_ID=your-app-web
# IDENTITY_SERVER_CLIENT_SECRET=

# AI (Anthropic) — server-side only, never NEXT_PUBLIC_
# ANTHROPIC_API_KEY=sk-ant-...

# Storage (AWS S3 or equivalent)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Encryption — 32-byte hex string for column-level encryption
# ENCRYPTION_KEY=

# Feature kill switches (set to "true" to instantly disable a route)
# KILL_SWITCH_FEATURE_A=false
# KILL_SWITCH_FEATURE_B=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging
# LOG_LEVEL=debug
