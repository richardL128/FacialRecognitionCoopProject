generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────
// Update these roles to match your application's access model.
// Also update src/lib/permissions/index.ts when roles change.

enum Role {
  PLATFORM_ADMIN  // Internal — full access to all tenants
  ADMIN           // Organisation-level administrator
  MANAGER         // Team / functional manager
  USER            // Standard application user
  VIEWER          // Read-only access
}

// ─── Tenants ──────────────────────────────────────────────────
// Top-level isolation unit. All data belongs to a Tenant.

model Tenant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users User[]
  cameraCaptures CameraCapture[]
  employeeProfiles EmployeeProfile[]
  employeeFaceLibrary EmployeeFaceLibrary[]
  faceModelTrainingJobs FaceModelTrainingJob[]
  faceModelVersions FaceModelVersion[]
  faceEmbeddings FaceEmbedding[]
  faceEmbeddingJobs FaceEmbeddingJob[]
  faceEmployeeCentroids FaceEmployeeCentroid[]

  @@map("tenants")
}

// ─── Users ────────────────────────────────────────────────────

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId      String    @unique @map("external_id")  // ID from your identity provider
  email           String
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  role            Role
  tenantId        String    @map("tenant_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  dashboardLayout Json?     @map("dashboard_layout")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  cameraCaptures CameraCapture[]
  enrolledEmployeeFaces EmployeeFaceLibrary[]
  requestedFaceModelTrainingJobs FaceModelTrainingJob[] @relation("FaceModelTrainingRequestedBy")
  requestedFaceEmbeddingJobs FaceEmbeddingJob[] @relation("FaceEmbeddingRequestedBy")

  @@index([tenantId])
  @@index([externalId])
  @@map("users")
}

model CameraCapture {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  imageUrl               String    @map("image_url")
  source                 String    @default("dashboard") @map("source")
  createdAt              DateTime  @default(now()) @map("created_at")
  recognitionStatus      String?   @map("recognition_status")
  recognizedEmployeeId   String?   @map("recognized_employee_id") @db.Uuid
  recognitionConfidence  Float?    @map("recognition_confidence")
  recognizedAt           DateTime? @map("recognized_at")

  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  user               User             @relation(fields: [userId], references: [id])
  recognizedEmployee EmployeeProfile? @relation("RecognizedCaptures", fields: [recognizedEmployeeId], references: [id])
  employeeFaceLibrary EmployeeFaceLibrary[]
  faceEmbeddings FaceEmbedding[]
  faceEmbeddingJobs FaceEmbeddingJob[]

  @@index([tenantId])
  @@index([userId])
  @@map("camera_captures")
}

model EmployeeProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  firstName    String   @map("first_name")
  name         String
  email        String?
  pinCode      String?  @map("pin_code")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  faces        EmployeeFaceLibrary[]
  faceEmbeddings FaceEmbedding[]
  faceEmbeddingJobs FaceEmbeddingJob[]
  faceEmployeeCentroids FaceEmployeeCentroid[]
  recognizedCaptures CameraCapture[]  @relation("RecognizedCaptures")

  @@index([tenantId])
  @@map("employee_profiles")
}

model EmployeeFaceLibrary {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  employeeProfileId String   @map("employee_profile_id") @db.Uuid
  captureId         String   @map("capture_id") @db.Uuid
  createdBy         String   @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  capture           CameraCapture   @relation(fields: [captureId], references: [id])
  creator           User            @relation(fields: [createdBy], references: [id])

  @@unique([employeeProfileId, captureId], name: "uq_employee_face_profile_capture")
  @@index([tenantId])
  @@index([employeeProfileId])
  @@map("employee_face_library")
}

model FaceModelTrainingJob {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  requestedBy      String?   @map("requested_by") @db.Uuid
  status           String    @default("pending")
  reason           String?
  dataDir          String?   @map("data_dir")
  outputDir        String?   @map("output_dir")
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  errorMessage     String?   @map("error_message")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  requestedByUser  User?     @relation("FaceModelTrainingRequestedBy", fields: [requestedBy], references: [id])
  modelVersions    FaceModelVersion[] @relation("FaceModelVersionSourceJob")

  @@index([tenantId])
  @@index([status, createdAt])
  @@map("face_model_training_jobs")
}

model FaceModelVersion {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  sourceJobId       String?   @map("source_job_id") @db.Uuid
  modelPath         String    @map("model_path")
  checkpointPath    String?   @map("checkpoint_path")
  dataDir           String    @map("data_dir")
  datasetClassCount Int       @map("dataset_class_count")
  datasetImageCount Int       @map("dataset_image_count")
  trainEpochs       Int       @map("train_epochs")
  valAccuracy       Float?    @map("val_accuracy")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  sourceJob         FaceModelTrainingJob? @relation("FaceModelVersionSourceJob", fields: [sourceJobId], references: [id])
  faceEmbeddings    FaceEmbedding[]

  @@index([tenantId, createdAt])
  @@map("face_model_versions")
}

model FaceEmbedding {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  employeeProfileId String    @map("employee_profile_id") @db.Uuid
  captureId         String    @map("capture_id") @db.Uuid
  modelVersionId    String?   @map("model_version_id") @db.Uuid
  modelKey          String    @map("model_key")
  embeddingDim      Int       @map("embedding_dim")
  embedding         Json
  // embedding_vec is the pgvector column. Populated on write; backfilled at startup for legacy rows.
  embeddingVec      Unsupported("vector(512)")?  @map("embedding_vec")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  capture           CameraCapture   @relation(fields: [captureId], references: [id])
  modelVersion      FaceModelVersion? @relation(fields: [modelVersionId], references: [id])

  @@unique([captureId, modelKey], name: "uq_face_embedding_capture_model")
  @@index([tenantId, active])
  @@index([tenantId, employeeProfileId])
  @@index([tenantId, modelKey, active])
  @@map("face_embeddings")
}

model FaceEmployeeCentroid {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  employeeProfileId String   @map("employee_profile_id") @db.Uuid
  modelKey          String   @map("model_key")
  // centroid_vec: L2-normalised mean of all active embedding_vec for this employee + model.
  centroidVec       Unsupported("vector(512)")  @map("centroid_vec")
  sampleCount       Int      @default(0) @map("sample_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id])

  @@unique([tenantId, employeeProfileId, modelKey], name: "uq_face_employee_centroid")
  @@index([tenantId, modelKey])
  @@map("face_employee_centroids")
}

model FaceEmbeddingJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  employeeProfileId String    @map("employee_profile_id") @db.Uuid
  captureId         String    @map("capture_id") @db.Uuid
  requestedBy       String?   @map("requested_by") @db.Uuid
  modelKey          String    @map("model_key")
  status            String    @default("pending")
  reason            String?
  errorMessage      String?   @map("error_message")
  startedAt         DateTime? @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id])
  capture           CameraCapture   @relation(fields: [captureId], references: [id])
  requestedByUser   User?           @relation("FaceEmbeddingRequestedBy", fields: [requestedBy], references: [id])

  @@index([tenantId])
  @@index([status, createdAt])
  @@index([tenantId, modelKey, status])
  @@map("face_embedding_jobs")
}

// ─── Audit Log ────────────────────────────────────────────────
// Append-only. REVOKE UPDATE, DELETE applied via db/migrations/audit_log_protection.sql

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String                              // e.g. 'user.record.updated'
  entityType String   @map("entity_type")        // e.g. 'user'
  entityId   String   @map("entity_id") @db.Uuid
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── Feature Flag Overrides ───────────────────────────────────
// Three-tier override system for feature flags.
// Tier 1 (Platform Admin): GLOBAL or per-TENANT overrides
// Tier 2 (Admin):          CLIENT-level overrides within their tenant
// Tier 3 (Future):         USER-level overrides

enum FlagScope {
  GLOBAL  // Applies to all tenants (platform admin only)
  TENANT  // Applies to a specific tenant
  CLIENT  // Applies to a client within a tenant
  USER    // Future: applies to a specific user
}

model FeatureFlagOverride {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flagKey   String    @map("flag_key")      // e.g. "module:feature-name"
  scope     FlagScope @default(TENANT)
  tenantId  String?   @map("tenant_id") @db.Uuid   // null for GLOBAL scope
  scopeId   String?   @map("scope_id")  @db.Uuid   // clientId for CLIENT, userId for USER
  enabled   Boolean   @default(true)
  reason    String?                                 // Why this override was set
  setBy     String    @map("set_by") @db.Uuid       // User who created/updated
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([flagKey, scope, tenantId, scopeId], name: "uq_flag_override")
  @@index([tenantId])
  @@map("feature_flag_overrides")
}

// ─── Add your domain models below ─────────────────────────────
// Remember: every tenant-scoped model needs:
//   - tenantId String @map("tenant_id") @db.Uuid
//   - @@index([tenantId])
//   - deletedAt DateTime? @map("deleted_at")  (for soft delete)
